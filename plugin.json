{
    "$schema": "https://github.com/duxlabs-dev/dux-shell/raw/refs/heads/master/quickshell/PLUGINS/plugin-schema.json",
    "id": "dankSoftwareDepot",
    "name": "Dux Software Depot",
    "description": "Software center for DMS: updates with progress, release notes, app store with reviews, installed-software management, firmware and an action log.",
    "version": "1.7.3",
    "author": "Vincent Blok",
    "license": "MIT",
    "icon": "deployed_code_update",
    "type": "widget",
    "capabilities": [
        "dankbar-widget"
    ],
    "component": "./UpdaterWidget.qml",
    "settings": "./UpdaterSettings.qml",
    "requires_dms": ">=1.6.0",
    "permissions": [
        "settings_read",
        "settings_write",
        "process",
        "network"
    ]
}
